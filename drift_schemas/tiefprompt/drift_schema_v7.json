  "fixed_sql": [
    {
      "name": "script_model",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"script_model\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"script_text\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"ephemeral\" INTEGER NOT NULL DEFAULT 0 CHECK (\"ephemeral\" IN (0, 1)), \"scroll_position\" REAL NULL);"
        }
      ]
    },
    {
      "name": "keybinding_map_model",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"keybinding_map_model\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT);"
        }
      ]
    },
    {
      "name": "settings_preset_model",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings_preset_model\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"data\" TEXT NOT NULL, \"keybindings\" INTEGER NOT NULL REFERENCES keybinding_map_model (id) ON DELETE CASCADE);"
        }
      ]
    },
    {
      "name": "keybinding_mapping_model",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"keybinding_mapping_model\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"map_id\" INTEGER NOT NULL REFERENCES keybinding_map_model (id) ON DELETE CASCADE, \"key_id\" INTEGER NOT NULL, \"ctrl\" INTEGER NOT NULL CHECK (\"ctrl\" IN (0, 1)), \"shift\" INTEGER NOT NULL CHECK (\"shift\" IN (0, 1)), \"alt\" INTEGER NOT NULL CHECK (\"alt\" IN (0, 1)), \"meta\" INTEGER NOT NULL CHECK (\"meta\" IN (0, 1)), \"action_name\" TEXT NOT NULL CHECK(\"action_name\" IN ('playPause', 'scrollUpSmall', 'scrollDownSmall', 'scrollUp', 'scrollDown', 'pageUp', 'pageDown', 'jumpStart', 'jumpEnd', 'toggleControls', 'speedUp', 'speedDown', 'fontSizeUp', 'fontSizeDown', 'openSettings', 'saveSettingsFromPrompter')));"
        }
      ]
    },
    {
      "name": "app_state_model",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_state_model\" (\"help_request_shown\" INTEGER NOT NULL CHECK (\"help_request_shown\" IN (0, 1)), \"last_seen_version\" TEXT NULL);"
        }
      ]
    }
